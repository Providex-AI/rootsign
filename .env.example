# ---------------------------------------------------------------------------
# Store-side infra config (read by rootsign.config.Settings — no prefix).
# These describe the PostgreSQL/TimescaleDB instance the storage layer
# connects to. Defaults assume the bundled docker-compose db service.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://rootsign:rootsign@localhost:5432/rootsign_dev
DATABASE_URL_SYNC=postgresql+psycopg2://rootsign:rootsign@localhost:5432/rootsign_dev
TEST_DATABASE_URL=postgresql+asyncpg://rootsign:rootsign@localhost:5432/rootsign_test
TEST_DATABASE_URL_SYNC=postgresql+psycopg2://rootsign:rootsign@localhost:5432/rootsign_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# RootSign SDK config (read by rootsign.sdk.config.SDKSettings, prefix
# ROOTSIGN_). User-facing — the developer using @rootsign.trace sets these.
# ---------------------------------------------------------------------------

# Transport: 'local' calls IngestHandler in-process (Phase 1 default).
# 'cloud' POSTs batched envelopes to the hosted backend via HttpIngestClient
# (ADR-013). Needs the cloud extra:  pip install 'rootsign[cloud]'
ROOTSIGN_BACKEND=local
# NOTE: CLOUD_URL already ends in /v1 — the request path is {CLOUD_URL}/ingest.
# ROOTSIGN_CLOUD_URL=https://ingest.getprovidex.com/v1
# ROOTSIGN_API_KEY=your-api-key-here
# Cloud transport tuning. HTTP_MAX_RETRIES counts TOTAL attempts (one send
# plus at most two retries at the default of 3), and the transport is the only
# layer that retries — the buffering client stands down when it wraps this one.
# ROOTSIGN_HTTP_TIMEOUT_SECONDS=10
# ROOTSIGN_HTTP_MAX_RETRIES=3
# Offline spool root. Defaults to $ROOTSIGN_DATA_DIR/spool, so moving DATA_DIR
# moves the spool with it; set this only to split them (e.g. a durable volume).
# When the endpoint is unreachable, records land in <spool>/sessions/<id>.jsonl
# — ordinary session files, so `rootsign verify --local` reads them while still
# offline. Upload them later with `rootsign-admin sync`.
# ROOTSIGN_SPOOL_DIR=~/.rootsign/spool
# What to do when a record cannot be persisted at all — endpoint unreachable
# AND the spool write failing (disk full, read-only mount). 'warn' (default)
# drops telemetry with accounting: one CRITICAL, a loss tally at session close,
# and a hash-evident gap so verify reports INCOMPLETE rather than VALID.
# 'fail' raises into the caller instead — a halted agent over an incomplete
# record. HiTL/approval records fail closed either way.
# ROOTSIGN_ON_RECORD_LOSS=warn

# Capture per-step Decision records (the agent's reasoning). Off by default
# because Decision payloads are the largest and most PII-sensitive surface.
# Enabling in production requires explicit user-consent acknowledgement.
ROOTSIGN_CAPTURE_DECISIONS=false

# Write-ahead log for events that failed ingest (network blip, DB down).
# The decorator drains this on the next successful call. Default: ~/.rootsign/wal
ROOTSIGN_WAL_PATH=~/.rootsign/wal

# LEGACY retry knobs — read by no code path. The cloud transport honors
# ROOTSIGN_HTTP_TIMEOUT_SECONDS / ROOTSIGN_HTTP_MAX_RETRIES instead (above).
ROOTSIGN_MAX_RETRIES=3
ROOTSIGN_RETRY_BASE_DELAY=0.1
ROOTSIGN_RETRY_MAX_DELAY=5.0
