# Required: OpenAI API key for the LangGraph agent's LLM calls.
OPENAI_API_KEY=sk-...

# Points the example at the shared examples TimescaleDB on port 5433.
# The main repo's dev DB lives on 5432 — keeping them distinct so they
# don't collide if you have both running.
ROOTSIGN_DATABASE_URL=postgresql+asyncpg://rootsign:rootsign@localhost:5433/rootsign_examples

# Same DB, sync driver. `rootsign-admin init` uses this for alembic.
ROOTSIGN_DATABASE_URL_SYNC=postgresql+psycopg2://rootsign:rootsign@localhost:5433/rootsign_examples
