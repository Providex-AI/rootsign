{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "RootSign",
  "description": "Developer documentation for RootSign, the open-source Python SDK that records AI agent tool calls on a tamper-evident hash chain.",
  "colors": {
    "primary": "#6B4FFF",
    "light": "#9B87FF",
    "dark": "#4B32CC"
  },
  "favicon": "/logo/favicon.png",
  "fonts": {
    "family": "Inter"
  },
  "appearance": {
    "default": "dark"
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart", "how-it-works"]
          },
          {
            "group": "Integrations",
            "pages": ["integrations/langgraph", "integrations/crewai", "integrations/mcp", "integrations/python"]
          },
          {
            "group": "Guides",
            "pages": ["guides/verify", "guides/evidence-bundles", "guides/human-approval", "guides/redaction", "guides/decision-capture", "guides/postgres", "guides/without-init", "guides/batching", "guides/cloud-and-sync"]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "SDK",
            "pages": ["reference/python-api", "reference/configuration", "reference/errors"]
          },
          {
            "group": "CLI",
            "pages": ["reference/cli-rootsign", "reference/cli-rootsign-admin"]
          },
          {
            "group": "Formats",
            "pages": ["reference/evidence-bundle", "reference/ingest-spec-v1"]
          }
        ]
      },
      {
        "tab": "Resources",
        "groups": [
          {
            "group": "Project",
            "pages": ["resources/framework-support", "resources/changelog", "resources/roadmap", "resources/design-decisions", "resources/security"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Providex AI",
        "href": "https://getprovidex.com"
      },
      {
        "type": "discord",
